%% 건강한하루 정보 구조(IA)
%% Day01 프로젝트 실습(User Story·MVP)의 MoSCoW 분류를 기준으로 작성
%% Figma 사용법: Figma에서 Mermaid를 지원하는 플러그인(Mermaid Diagram / Mermaid to Figma 등)을 열고
%%              이 파일 내용을 붙여넣으면 프레임/노드로 변환할 수 있습니다.
%% 범례: must(초록, 첫 버전 필수) / should(파랑, 있으면 좋음) / could(회색, 다음 단계 검토) / wont(점선, 이번 범위 제외)

flowchart TD
    ROOT["건강한하루"]

    %% ── 사용 시작 ─────────────────────────
    subgraph G0["사용 시작"]
        HOME["홈 화면<br/>배너 · 건강 고민 카테고리"]
    end

    %% ── 정보 입력 ─────────────────────────
    subgraph G1["정보 입력"]
        INPUT["건강 고민 · 증상 입력<br/>(RF-1.1)"]
        ALLERGY["알레르기 · 복용 중 제품 입력<br/>(선택)"]
    end

    %% ── 핵심 결과 ─────────────────────────
    subgraph G2["핵심 결과"]
        RESULT["맞춤 상품 추천 결과<br/>최대 5개 (RF-1.2)"]
        REASON["추천 근거 표시<br/>(RF-1.3)"]
        DOSAGE["권장 · 상한 섭취량 표시<br/>(RF-4.1)"]
    end

    %% ── 확인과 수정 ────────────────────────
    subgraph G3["확인과 수정"]
        DETAIL["상품 상세<br/>성분 · 섭취방법 · 주의사항"]
        EXPLAIN["성분 쉬운 설명<br/>(RF-2.0)"]
        RETRY["재추천 요청<br/>(RF-1.4)"]
        CHAT["AI 상담 · RAG FAQ<br/>(RF-3.0)"]
    end

    %% ── 저장과 공유 ────────────────────────
    subgraph G4["저장과 공유"]
        WARN["과다섭취 경고 안내<br/>복수 제품 합산(RF-4.2)"]
        SAVE["관심 상품 저장 · 이력"]
    end

    %% ── 운영 관리 ─────────────────────────
    subgraph G5["운영 관리"]
        LOG["추천 · 상담 · 경고 이력 로그<br/>(CS팀 · 법무팀 확인용)"]
        CS["CS 이관 분기<br/>(RF-3.4)"]
    end

    ROOT --> HOME
    HOME --> INPUT
    INPUT --> ALLERGY
    INPUT --> RESULT
    ALLERGY --> RESULT
    RESULT --> REASON
    RESULT --> DOSAGE
    RESULT --> DETAIL
    DETAIL --> EXPLAIN
    RESULT --> RETRY
    RESULT --> CHAT
    CHAT --> CS
    DETAIL --> WARN
    DETAIL --> SAVE
    RESULT -.-> LOG
    CHAT -.-> LOG

    classDef must fill:#d6f5d6,stroke:#2e7d32,stroke-width:2px;
    classDef should fill:#dbe9ff,stroke:#1565c0,stroke-width:1.5px;
    classDef could fill:#eeeeee,stroke:#616161,stroke-width:1px;
    classDef wont fill:#ffffff,stroke:#9e9e9e,stroke-width:1px,stroke-dasharray:4 3;

    class HOME,INPUT,RESULT,REASON,DOSAGE must;
    class ALLERGY,DETAIL,EXPLAIN,RETRY should;
    class CHAT,CS could;
    class WARN,SAVE,LOG wont;
