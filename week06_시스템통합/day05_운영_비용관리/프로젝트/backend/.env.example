GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

######################
# RF-3 외부 조회 Tool (뉴스 검색 / 회수·경보 검색)
######################
TAVILY_API_KEY=""

######################
# RF-3 내부 지식베이스 RAG (벡터 검색)
# 로컬 Ollama 임베딩을 사용하므로 API 키가 필요 없습니다.
# 실행 전에 아래 두 가지를 먼저 준비하세요.
#   1) ollama pull qwen3-embedding:0.6b
#   2) ollama serve
######################
EMBEDDING_MODEL="qwen3-embedding:0.6b"

######################
# 테스트용 AI 모델 실행 여부 (1: 실행, 0: 미실행)
######################
RUN_LIVE_AI_TESTS ="1"